# =============================================================================
# RShopRefills — environment template
# =============================================================================
# Copy to .env and fill in. Every variable the application actually reads is
# listed here; anything absent is either a framework default or dead config.
#
# Secrets live in the credential escrow (see docs/ONCALL.md), NOT only on the
# server. A value that exists in exactly one place is a value you will lose.
#
# Full reference, including who owns each key and its rotation schedule:
#   docs/OPERATIONS.md
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="RShopRefills"
APP_ENV=local                      # local | staging | production
APP_KEY=                           # php artisan key:generate
APP_DEBUG=true                     # MUST be false in production
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# Canonical host + any alternates that should 301 to it.
APP_CANONICAL_HOST=
APP_ALTERNATE_HOSTS=
# Comma-separated old APP_KEYs, kept so existing encrypted payloads still decrypt
# after a key rotation. Never remove one until nothing encrypted with it remains.
APP_PREVIOUS_KEYS=

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rshoprefills_v2
DB_USERNAME=root
DB_PASSWORD=
# Directory holding mysqldump/mysql when they are not on PATH.
# XAMPP on Windows: C:/xampp/mysql/bin — leave empty on Linux servers.
DB_DUMP_BINARY_PATH=
DB_DUMP_TIMEOUT=900

# --- Cache / queue / session -------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true         # false only for plain-HTTP local dev

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# Redis MUST be bound to localhost or firewalled. An internet-reachable Redis is
# a breach: it holds sessions, cache, and webhook replay-protection keys.

# --- Filesystem --------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Backups (P0-1) ----------------------------------------------------------
# Production MUST include an off-site disk. A backup that only exists on the
# machine it is protecting is not a backup.
BACKUP_DESTINATION_DISKS=backup-local
BACKUP_ARCHIVE_NAME=rshoprefills
# AES-256 passphrase, >= 24 random characters. WITHOUT THIS VALUE THE ARCHIVES
# CANNOT BE DECRYPTED — store it in the credential escrow before going live.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_AGE_HOURS=26
BACKUP_MAX_STORAGE_MB=20000
BACKUP_MIN_ARCHIVE_BYTES=32768
BACKUP_MIN_DUMP_BYTES=4096
# Off-site bucket: enable versioning + object lock so `backup:clean` and a stolen
# credential can only delete logically. Credentials are deliberately separate
# from the application AWS_* keys.
BACKUP_REMOTE_ACCESS_KEY_ID=
BACKUP_REMOTE_SECRET_ACCESS_KEY=
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_ENDPOINT=
BACKUP_REMOTE_REGION=auto
BACKUP_REMOTE_USE_PATH_STYLE=true

# --- Operational alerting (P0-3) ---------------------------------------------
# Without at least one of these the platform cannot tell anyone anything: a
# 3 a.m. outage is discovered by customers. Verify with `alerting:test sev1`.
ALERTING_ENABLED=true
ALERTING_THROTTLE_MINUTES=60
# PRIMARY. Telegram carries SEV-1 and SEV-2: a phone can be set to override
# silent mode for one chat, which email and Slack cannot do reliably.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
# SECONDARY. Backstop for SEV-1 and the only channel for the SEV-3 digest.
OPS_ALERT_EMAIL=
# OPTIONAL. Slack stays out of the routing table unless switched on here, so a
# stale webhook cannot be mistaken for a working escalation path.
OPS_SLACK_ENABLED=false
OPS_SLACK_WEBHOOK_URL=
OPS_RUNBOOK_BASE=docs/runbooks

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily                    # `daily` not `single`: single-file logs grow unbounded
LOG_LEVEL=debug                    # `warning` or above in production
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# --- Error tracking ----------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false      # keep false: this app handles KYC and payment data

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=log                    # `resend` or `smtp` in production
MAIL_LOG_CHANNEL=mail              # keeps rendered MIME (base64 images and all) out of laravel.log
MAIL_LOG_DAYS=3                    # rendered mail is a debugging aid, not a record
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="info@rshoprefill.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=
ADMIN_ALERT_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# --- Pricing integrity -------------------------------------------------------
# legacy = floor off | shadow = log what it would raise | enforce = clamp prices.
# Never jump straight to enforce: verify cost data with `pricing:audit-below-cost`
# first, or the floor raises storefront prices by the same corrupt factor.
PRICING_FLOOR_MODE=legacy
PRICING_MIN_MARGIN_PERCENT=1
PRICING_SAFETY_MARKUP_PERCENT=10

# --- Payment providers -------------------------------------------------------
PAYMENT_MOCK=false                 # true short-circuits gateways; NEVER true in production

# Flutterwave (cards, bank)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=

# Paystack (fiat backup: cards, Apple Pay, USSD, NGN transfers; serves traffic only while Flutterwave is off)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Comma-separated card/Apple Pay charge currencies. Add USD once Paystack approves international USD collection.
PAYSTACK_CHARGE_CURRENCIES=NGN

# Kora Pay (fiat backup: XAF/XOF/GHS/KES/EGP/TZS mobile money, NGN bank rails; serves traffic only while Flutterwave is off)
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_ENCRYPTION_KEY=

# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
# Both default to true and both protect margin — change only deliberately.
# fixed_rate locks the quoted crypto rate so volatility between quote and
# confirmation is NOWPayments' risk, not ours. fee_paid_by_user puts the network
# fee on the payer; setting it false means the platform absorbs it per payment.
NOWPAYMENTS_FIXED_RATE=true
NOWPAYMENTS_FEE_PAID_BY_USER=true

# Smile ID (KYC identity verification). SMILE_SERVER: 0 = sandbox, 1 = production.
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_SERVER=0
SMILE_CALLBACK_URL=

# --- Fulfillment providers ---------------------------------------------------
# Zendit (gift cards, airtime, bills)
ZENDIT_BASE_URL=
ZENDIT_API_KEY=
ZENDIT_SECRET=

# Airalo (eSIM). Webhooks are HMAC-signed with the webhook secret if one has been
# arranged, otherwise with the client secret. Unsigned requests are accepted ONLY
# in local/testing — staging and production fail closed.
AIRALO_BASE_URL=https://sandbox-partners-api.airalo.com/v2
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
AIRALO_WEBHOOK_SECRET=

# --- Auth / social -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Bot protection ----------------------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE_CHECKOUT=true
TURNSTILE_ENFORCE_AUTH=true
TURNSTILE_ENFORCE_CONTACT=true
TURNSTILE_BYPASS_LOCAL=true

# --- Web push ----------------------------------------------------------------
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PEM_FILE=

# --- Horizon -----------------------------------------------------------------
HORIZON_NAME=
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# --- Security ----------------------------------------------------------------
SECURITY_DEVICE_RESTRICTION_HOURS=24

# --- Third-party / marketing -------------------------------------------------
GOOGLE_ANALYTICS_ID=
CHATWAY_WIDGET_ID=
TRUSTPILOT_BUSINESS_UNIT_ID=
TRUSTPILOT_REVIEW_COLLECTOR_TEMPLATE_ID=
TRUSTPILOT_REVIEW_COLLECTOR_TOKEN=
TRUSTPILOT_PROFILE_URL=
TRUSTPILOT_SHORT_LINK=
TRUSTPILOT_LOCALE=en-GB
GOOGLE_REVIEW_URL=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_REVIEWS_MERCHANT_ID=
GOOGLE_REVIEWS_BADGE_ENABLED=false
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# --- Frontend ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# NOWPayments sandbox. Sandbox uses a SEPARATE account, API key and IPN secret
# from production (account-sandbox.nowpayments.io) — flipping the flag alone is
# not enough. CASE simulates the outcome: success | partially_paid | failed | common
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_SANDBOX_BASE_URL=https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_SANDBOX_CASE=
