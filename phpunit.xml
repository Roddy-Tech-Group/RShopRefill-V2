<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Gateway keys never come from the developer's .env: tests mock every gateway unless they set a key themselves. -->
        <env name="KORAPAY_PUBLIC_KEY" value=""/>
        <env name="KORAPAY_SECRET_KEY" value=""/>
        <env name="KORAPAY_ENCRYPTION_KEY" value=""/>
        <env name="PAYSTACK_SECRET_KEY" value=""/>
        <env name="PAYSTACK_PUBLIC_KEY" value=""/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <!--
            The undeliverable-domain suppression list is blanked because the
            whole suite (and Faker) addresses mail to @example.com. Tests that
            exercise suppression set communication.undeliverable_domains
            themselves.
        -->
        <env name="MAIL_UNDELIVERABLE_DOMAINS" value=""/>
        <env name="RESEND_KEY" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="FLW_PUBLIC_KEY" value="FLW_PUB_KEY_MOCK"/>
        <env name="FLW_SECRET_KEY" value="FLW_SECRET_KEY_MOCK"/>
        <env name="FLW_WEBHOOK_HASH" value="FLW_WEBHOOK_HASH_MOCK"/>
        <env name="ZENDIT_API_KEY" value="ZENDIT_API_KEY_MOCK"/>
        <env name="TURNSTILE_ENABLED" value="false"/>
        <!--
            Alert channels are blanked so the suite behaves identically on a
            developer machine and on CI. A real OPS_TELEGRAM_* pair in a local
            .env once made a /health assertion pass for the wrong reason, and CI
            was the first thing to notice. Tests that need a channel must
            configure it themselves.
        -->
        <env name="OPS_TELEGRAM_BOT_TOKEN" value=""/>
        <env name="OPS_TELEGRAM_CHAT_ID" value=""/>
        <env name="OPS_ALERT_EMAIL" value=""/>
        <env name="OPS_SLACK_ENABLED" value="false"/>
        <env name="OPS_SLACK_WEBHOOK_URL" value=""/>
    </php>
</phpunit>
